+
+            void spawn_life()
+            {
+                mobs_spawned.clear();
+                npcs.clear();
+
+                std::string strid  = string_format::extend_id(mapid(), 9);
+                std::string prefix = std::to_string(mapid() / 100000000);
+                nl::node life = nl::nx::map["Map"]["Map" + prefix][strid + ".img"]["life"];
+
+                int32_t oid = 1000;
+                for (nl::node sub : life)
+                {
+                    int32_t id = string_conversion::or_zero<int32_t>(sub["id"].get_string());
+                    if (id == 0)
+                    {
+                        id = sub["id"];
+                    }
+                    if (sub["type"].get_string() == "n")
+                    {
+                        npcs.push_back({ id, sub["x"], sub["cy"] });
+                        continue;
+                    }
+                    if (sub["type"].get_string() != "m" || !hazards)
+                    {
