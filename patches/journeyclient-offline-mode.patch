+    TrapHit TilesObjs::find_trap(const Rectangle<int16_t>& rect) const
+    {
+        for (const auto& iter : objs)
+        {
+            const Obj& obj = iter.second;
+            if (!obj.is_trap())
+            {
+                continue;
+            }
+            Rectangle<int16_t> box = obj.get_hitbox();
+            if (box.width() == 0 && box.height() == 0)
+            {
+                continue;
+            }
+            if (box.overlaps(rect))
+            {
+                TrapHit hit;
+                hit.damage = obj.get_damage();
+                hit.origin = obj.get_position();
+                hit.obj = &obj;
+                return hit;
+            }
+        }
+        return {};
+    }
