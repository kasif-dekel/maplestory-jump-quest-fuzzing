 namespace jrc
 {
+    namespace
+    {
+        constexpr int32_t COS_STEPS = 4096;
+        constexpr int32_t COS_SCALE = 65536;
+
+        // cos(2 pi i / 4096) * 65536, rounded to integers once: positions are
+        // then pure integer arithmetic, identical on gcc, clang and wasm
+        // (gameplay must not depend on a libm's last bit).
+        const int32_t* cos_table()
+        {
+            static int32_t table[COS_STEPS];
+            static bool ready = false;
+            if (!ready)
+            {
+                for (int32_t i = 0; i < COS_STEPS; ++i)
+                {
+                    table[i] = static_cast<int32_t>(std::lround(std::cos(2.0 * M_PI * i / COS_STEPS) * COS_SCALE));
+                }
+                ready = true;
+            }
+            return table;
+        }
+
+        int16_t scaled(int32_t amplitude, int32_t c)
+        {
+            int64_t v = static_cast<int64_t>(amplitude) * c;
+            v += v >= 0 ? COS_SCALE / 2 : -(COS_SCALE / 2);
+            return static_cast<int16_t>(v / COS_SCALE);
+        }
+    }
