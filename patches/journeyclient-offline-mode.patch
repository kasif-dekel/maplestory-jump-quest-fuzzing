+        animation = Animation(source);
         pos = Point<int16_t>(src["x"], src["y"]);
         flip = src["f"].get_bool();
         z = src["z"];
+        damage = source["damage"];
+        name = src["oS"].get_string() + "/" + src["l0"].get_string() + "/"
+            + src["l1"].get_string() + "/" + src["l2"].get_string();
+
+        // The move attributes sit on the first frame in the v83 data
+        // (Obj/trap.img/moving/nature/0/0/moveType); accept them on the obj
+        // node too.
+        nl::node mv = source["0"]["moveType"] ? source["0"] : source;
+        move_type = mv["moveType"];
+        move_w = mv["moveW"];
+        move_h = mv["moveH"];
