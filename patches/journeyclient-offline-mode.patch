+    Point<int16_t> Obj::get_offset() const
+    {
+        if (move_type < 1 || move_type > 3)
+        {
+            return {};
+        }
+        const int32_t* table = cos_table();
+        int32_t idx = static_cast<int32_t>((static_cast<int64_t>(move_ms) * COS_STEPS) / move_p) % COS_STEPS;
+        int32_t c = table[idx];
+        int32_t s = table[(idx + 3 * COS_STEPS / 4) % COS_STEPS];  // sin wt = cos(wt - 90 deg)
+        int16_t dx = scaled(move_w, c);
+        int16_t dy = scaled(move_h, move_type == 3 ? s : c);
+        return Point<int16_t>(dx, dy);
+    }
