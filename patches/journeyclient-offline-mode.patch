+        void check_goal()
+        {
+            if (goal_reached)
+            {
+                return;
+            }
+            Player& player = Stage::get().get_player();
+            Point<int16_t> pos = player.get_position();
+            if (goal.compare(0, 3, "xy:") == 0)
+            {
+                // "xy:X,Y": standing on the ground next to a map point.
+                std::size_t comma = goal.find(',');
+                if (comma == std::string::npos)
+                {
+                    return;
+                }
+                int32_t gx = string_conversion::or_zero<int32_t>(goal.substr(3, comma - 3));
+                int32_t gy = string_conversion::or_zero<int32_t>(goal.substr(comma + 1));
+                if (player.get_phobj().onground && std::abs(pos.x() - gx) <= 40 && std::abs(pos.y() - gy) <= 30)
+                {
+                    goal_reached = true;
+                    Portal::WarpInfo info(0, Portal::SPAWN, false, "", goal);
+                    info.valid = true;
+                    notify_exit(info);
+                }
+                return;
+            }
+            if (goal.compare(0, 4, "npc:") != 0)
+            {
+                return;
+            }
+            int32_t want = string_conversion::or_zero<int32_t>(goal.substr(4));
+            for (const MobInfo& npc : npcs)
+            {
+                // Standing next to the NPC, close enough to talk to it.
+                if (npc.id == want && player.get_phobj().onground
+                    && std::abs(pos.x() - npc.x) <= 40 && std::abs(pos.y() - npc.y) <= 30)
+                {
+                    goal_reached = true;
+                    Portal::WarpInfo info(0, Portal::SPAWN, false, "", "npc:" + std::to_string(want));
+                    info.valid = true;
+                    notify_exit(info);
+                    return;
+                }
+            }
+        }
+
+        void spawn(bool with_ui)
+        {
+            Randomizer::seed(OFFLINE_SEED);
+
+            Stage& stage = Stage::get();
+            stage.clear();
+            stage.loadplayer(make_player());
+            stage.get_player().recalc_stats(true);
+            hp = stage.get_player().get_stats().get_stat(Maplestat::HP);
+            stage.get_player().get_stats().set_damage_override(
+                string_conversion::or_default<int32_t>(Setting<OfflineDamagePerHit>::get().load(), 1));
+            lava_lethal = Setting<OfflineLavaLethal>::get().load() != "0";
+            goal = Setting<OfflineGoal>::get().load();
+            hidden_reset = Setting<OfflineHiddenPortals>::get().load() != "ignore";
+            hidden_reset_all = Setting<OfflineHiddenPortals>::get().load() == "reset-all";
+            goal_reached = false;
+            stage.load(mapid(), static_cast<int8_t>(portalid()));
+            spawn_life();
+
+            previous_mask = 0;
+
+            std::string encoded = Setting<OfflineReplay>::get().load();
+            if (!encoded.empty())
+            {
+                set_replay(decode_base64(encoded));
+            }
+
+            std::string deathy = Setting<OfflineDeathY>::get().load();
+            has_death_y = !deathy.empty();
+            death_y = string_conversion::or_zero<int32_t>(deathy);
+            trace = Setting<OfflineTrace>::get().load() == "1";
+            tick_count = 0;
+            reported_end = false;
+
+            if (with_ui)
+            {
+                UI& ui = UI::get();
+                ui.change_state(UI::GAME);
+
+                // The key map normally arrives from the server. Install
+                // MapleStory's default action keys so the map is playable by
+                // hand in the browser (key numbers are MapleStory key codes).
+                ui.add_keymapping(56, KeyType::ACTION, KeyAction::JUMP);   // left alt
+                ui.add_keymapping(87, KeyType::ACTION, KeyAction::JUMP);   // right alt
+                ui.add_keymapping(29, KeyType::ACTION, KeyAction::ATTACK); // left ctrl
+                ui.add_keymapping(44, KeyType::ACTION, KeyAction::PICKUP); // z
+                ui.add_keymapping(45, KeyType::ACTION, KeyAction::SIT);    // x
+            }
+        }
+
+        void apply_input(uint8_t mask)
+        {
+            mask &= KEY_MASK;
+            uint8_t changed = static_cast<uint8_t>(previous_mask ^ mask);
+            if (changed == 0)
+            {
+                return;
+            }
+
+            Stage& stage = Stage::get();
+            for (const KeyBinding& binding : BINDINGS)
+            {
+                if ((changed & binding.bit) && !(mask & binding.bit))
+                {
+                    stage.send_key(KeyType::ACTION, binding.action, false);
+                }
+            }
+            for (const KeyBinding& binding : BINDINGS)
+            {
+                if ((changed & binding.bit) && (mask & binding.bit))
+                {
+                    stage.send_key(KeyType::ACTION, binding.action, true);
+                }
+            }
+            previous_mask = mask;
+        }
+
+        void release_all()
+        {
+            apply_input(0);
+        }
+
+        void set_replay(std::vector<uint8_t> bytes)
+        {
+            replay = std::move(bytes);
+            replay_pos = 0;
+            replay_tick = 0;
+            replay_released = replay.empty();
+        }
+
+        bool replay_active()
+        {
+            return replay_pos < replay.size();
+        }
+
+        void tick()
+        {
+            tick_count++;
+
+            // Reseed every tick from the tick number: whatever else draws from
+            // the shared engine (UI in the browser build, nothing in the
+            // harness), mob AI sees the same random sequence in both.
+            Randomizer::seed(OFFLINE_SEED ^ (static_cast<uint32_t>(tick_count) * 2654435761u));
+
+            if (trace)
+            {
+                // Positions at the start of this update, i.e. the result of
+                // update tick_count-1; matches the harness "T tick x y" lines.
+                Player& pl = Stage::get().get_player();
+                Point<int16_t> pos = pl.get_position();
+                char exact[64];
+                std::snprintf(exact, sizeof(exact), "%.17g %.17g", pl.get_phobj().crnt_x(), pl.get_phobj().crnt_y());
+                std::cout << "T " << (tick_count - 1) << " " << pos.x() << " " << pos.y() << " 0 0 " << exact << "\n";
+                int32_t oid = 1000;
+                for (size_t m = 0; m < mobs_spawned.size(); ++m, ++oid)
+                {
+                    Point<int16_t> mpos = Stage::get().get_mobs().get_mob_position(oid);
+                    std::cout << "M " << (tick_count - 1) << " " << oid << " " << mpos.x() << " " << mpos.y() << "\n";
+                }
+            }
+
+            if (replay_pos < replay.size() && has_death_y
+                && Stage::get().get_player().get_position().y() > death_y)
+            {
+                // Same rule as the harness: falling ends the attempt.
+                kill_player("fell into the lava");
+            }
+
+            if (replay_pos >= replay.size())
+            {
+                if (!replay_released)
+                {
+                    release_all();
+                    replay_released = true;
+                }
+                if (!replay.empty() && !reported_end)
+                {
+                    reported_end = true;
+                    Console::get().print("[offline] replay finished at tick " + std::to_string(tick_count));
+                }
+                return;
+            }
+
+            apply_input(replay[replay_pos]);
+            if (++replay_tick >= TICKS_PER_BYTE)
+            {
+                replay_tick = 0;
+                replay_pos++;
+            }
+        }
+
+        int32_t ticks()
+        {
+            return tick_count;
+        }
+
+        void set_on_exit(PortalHandler handler)
+        {
+            on_exit = handler;
+        }
+
+        void set_on_reset(PortalHandler handler)
+        {
+            on_reset = handler;
+        }
+
+        void set_on_hit(HitHandler handler)
+        {
+            on_hit = handler;
+        }
+
+        void set_on_trap(TrapHandler handler)
+        {
+            on_trap = handler;
+        }
+
+        void set_on_damage(DamageHandler handler)
+        {
+            on_damage = handler;
+        }
+
+        int32_t hp_left()
+        {
+            return hp;
+        }
+
+        namespace
+        {
+            bool take_damage(int32_t damage, const std::string& why)
+            {
+                if (damage < 1)
+                {
+                    damage = 1;
+                }
+                hp -= damage;
+                if (hp < 0)
+                {
+                    hp = 0;
+                }
+                Stage::get().get_player().get_stats().set_stat(Maplestat::HP, static_cast<uint16_t>(hp));
+                if (on_damage)
+                {
+                    on_damage(damage, hp, why);
+                }
+                else
+                {
+                    Console::get().print("[offline] " + why + ": -" + std::to_string(damage)
+                        + " HP, " + std::to_string(hp) + " left, tick " + std::to_string(tick_count));
+                }
+                return hp <= 0;
+            }
+        }
+
+        namespace
+        {
+            void kill_player(const std::string& why)
+            {
+                Console::get().print("[offline] " + why + " at tick " + std::to_string(tick_count));
+                Player& player = Stage::get().get_player();
+                player.get_stats().set_stat(Maplestat::HP, 0);
+                player.die();
+                replay_pos = replay.size();
+            }
+        }
+
+        void notify_hit(int32_t mob_oid, int32_t damage)
+        {
+            if (!take_damage(damage, "touched by mob " + std::to_string(mob_oid)))
+            {
+                return;
+            }
+            if (on_hit)
+            {
+                on_hit(mob_oid);
+            }
+            else
+            {
+                kill_player("killed by mob " + std::to_string(mob_oid));
+            }
+        }
+
+        void notify_trap(int32_t damage, const std::string& name)
+        {
+            bool lava = name.find("trap/area") != std::string::npos;
+            if (lava && lava_lethal)
+            {
+                // Falling into the lava fails the jump quest no matter the HP.
+                damage = hp > 0 ? hp : 1;
+            }
+            if (!take_damage(damage, "hit by trap " + name))
+            {
+                return;
+            }
+            if (on_trap)
+            {
+                on_trap(damage, name);
+            }
+            else
+            {
+                kill_player("killed by trap " + name);
+            }
+        }
+
+        void notify_exit(const Portal::WarpInfo& warpinfo)
+        {
+            bool is_goal = goal.empty() || warpinfo.name == goal
+                || (goal.compare(0, 7, "portal:") == 0 && warpinfo.name == goal.substr(7));
+            if (!is_goal)
+            {
+                // Some other map exit (e.g. the way back): the attempt is over.
+                Console::get().print("[offline] left the map through " + warpinfo.name
+                    + " at tick " + std::to_string(tick_count));
+                notify_reset(warpinfo);
+                return;
+            }
+            if (on_exit)
+            {
+                on_exit(warpinfo);
+            }
+            else
+            {
+                Console::get().print("[offline] SOLVED: " + warpinfo.name
+                    + (warpinfo.mapid > 0 ? " -> map " + std::to_string(warpinfo.mapid) : std::string())
+                    + " at tick " + std::to_string(tick_count));
+                // Freeze the replay so the character stays there.
+                replay_pos = replay.size();
+            }
+        }
+
+        void notify_reset(const Portal::WarpInfo& warpinfo)
+        {
+            if (on_reset)
+            {
+                on_reset(warpinfo);
+            }
+            else
+            {
+                Console::get().print("[offline] reset portal: " + warpinfo.name
+                    + " -> " + warpinfo.toname);
+            }
+        }
+
+        std::vector<uint8_t> decode_base64(const std::string& text)
+        {
+            auto value_of = [](char c) -> int
+            {
+                if (c >= 'A' && c <= 'Z') return c - 'A';
+                if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+                if (c >= '0' && c <= '9') return c - '0' + 52;
+                if (c == '+' || c == '-') return 62;
+                if (c == '/' || c == '_') return 63;
+                return -1;
+            };
+
+            std::vector<uint8_t> out;
+            uint32_t buffer = 0;
+            int bits = 0;
+            for (char c : text)
+            {
+                int v = value_of(c);
+                if (v < 0)
+                {
+                    continue;
+                }
+                buffer = (buffer << 6) | static_cast<uint32_t>(v);
+                bits += 6;
+                if (bits >= 8)
+                {
+                    bits -= 8;
+                    out.push_back(static_cast<uint8_t>((buffer >> bits) & 0xFF));
+                }
+            }
+            return out;
+        }
+    }
+}
diff --git a/src/client/Offline/Offline.h b/src/client/Offline/Offline.h
new file mode 100644
index 0000000..4f1dbd2
--- /dev/null
+++ b/src/client/Offline/Offline.h
@@ -0,0 +1,104 @@
+#pragma once
+#include "../Gameplay/MapleMap/Portal.h"
+#include "../Net/Login.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace jrc
+{
+    // Offline mode runs the real Stage/Player/Physics code path without a
+    // server: a synthetic character is spawned directly on a map and key
+    // input comes from a byte stream instead of the keyboard. The fuzzing
+    // harness and the browser replay share this module so that an input
+    // found by the fuzzer means exactly the same thing when replayed.
+    namespace Offline
+    {
+        // One input byte is a key mask held for TICKS_PER_BYTE physics ticks.
+        constexpr uint8_t KEY_LEFT  = 0x01;
+        constexpr uint8_t KEY_RIGHT = 0x02;
+        constexpr uint8_t KEY_JUMP  = 0x04;
+        constexpr uint8_t KEY_UP    = 0x08;
+        constexpr uint8_t KEY_DOWN  = 0x10;
+        constexpr uint8_t KEY_MASK  = 0x1F;
+        constexpr int32_t TICKS_PER_BYTE = 4;
+
+        // True when the OfflineMapId setting is non-empty.
+        bool enabled();
+        int32_t mapid();
+        uint8_t portalid();
+
+        // A plain character whose walk and jump forces match an unequipped
+        // v83 character (speed 100, jump 100), with OfflineHp hit points. Every
+        // hit (mob touch, trap) deals OfflineDamagePerHit and grants the
+        // client's usual two seconds of invincibility; the run ends at 0 HP.
+        CharEntry make_player();
+        int32_t hp_left();
+
+        // Map hazards: the mobs listed in the map's "life" node are spawned
+        // client-side with a fixed random seed so their patrols are
+        // reproducible. Off by default only for experiments.
+        void set_hazards(bool enabled);
+        struct MobInfo
+        {
+            int32_t id;
+            int16_t x;
+            int16_t y;
+        };
+        const std::vector<MobInfo>& spawned_mobs();
+        // NPCs from the map's life node (not spawned; used for goals and plots).
+        const std::vector<MobInfo>& map_npcs();
+        // True when invisible target-less portals send the player back to spawn.
+        bool hidden_portals_reset();
+        // OfflineHiddenPortals = "reset-all": every hidden portal, target or
+        // not, sends the player back to the spawn (no teleport shortcuts).
+        bool hidden_portals_reset_all();
+        // Called by Stage after the player moved: checks an "npc:<id>" goal.
+        void check_goal();
+
+        // Mirror of the SetField packet handler without the packet: load the
+        // player, load the map, and optionally switch the UI to the game
+        // state. Also arms the replay if OfflineReplay is set.
+        void spawn(bool with_ui);
+
+        // Feed one key mask. Only transitions relative to the previous mask
+        // are sent, exactly as a keyboard would generate press/release events.
+        void apply_input(uint8_t mask);
+        void release_all();
+
+        // Replay support: bytes are consumed by tick(), one byte per
+        // TICKS_PER_BYTE ticks, then all keys are released. A replay also
+        // stops when the player falls below the OfflineDeathY setting, so the
+        // browser shows the attempt exactly as far as the harness scored it.
+        void set_replay(std::vector<uint8_t> bytes);
+        bool replay_active();
+        void tick();
+        int32_t ticks();
+
+        // Portal events raised by Stage while offline. The harness uses them
+        // as stop triggers; the browser build just logs.
+        using PortalHandler = void (*)(const Portal::WarpInfo& warpinfo);
+        using HitHandler = void (*)(int32_t mob_oid);
+        using TrapHandler = void (*)(int32_t damage, const std::string& name);
+        using DamageHandler = void (*)(int32_t damage, int32_t hp_left, const std::string& why);
+        void set_on_exit(PortalHandler handler);
+        void set_on_reset(PortalHandler handler);
+        // Death handlers: called when a mob touch / trap hit brings HP to 0.
+        void set_on_hit(HitHandler handler);
+        void set_on_trap(TrapHandler handler);
+        // Called for every hit taken, lethal or not.
+        void set_on_damage(DamageHandler handler);
+        // A warp portal to another map was used. It is the solve when it
+        // matches OfflineGoal (or when no goal is set); otherwise leaving the
+        // map ends the attempt like a reset.
+        void notify_exit(const Portal::WarpInfo& warpinfo);
+        void notify_reset(const Portal::WarpInfo& warpinfo);
+        // A mob touched the player for `damage` points.
+        void notify_hit(int32_t mob_oid, int32_t damage);
+        // A damage trap (falling stone, steam vent, lava area) hit the player.
+        void notify_trap(int32_t damage, const std::string& name);
+
+        std::vector<uint8_t> decode_base64(const std::string& text);
+    }
+}
diff --git a/src/client/Util/Randomizer.h b/src/client/Util/Randomizer.h
index 7c13972..faab41d 100644
--- a/src/client/Util/Randomizer.h
+++ b/src/client/Util/Randomizer.h
@@ -25,6 +25,13 @@ namespace jrc
     class Randomizer
     {
     public:
+        // Reseed the shared engine. Offline mode uses a fixed seed so that mob
+        // movement, and therefore a whole replay, is reproducible.
+        static void seed(uint32_t value)
+        {
+            engine().seed(value);
+        }
+
         bool next_bool() const
         {
             return next_int(2) == 1;
@@ -52,10 +59,14 @@ namespace jrc
             if (from >= to)
                 return from;
 
-            std::uniform_real_distribution<T> range(from, to);
-            std::random_device rd;
-            std::default_random_engine engine{ rd() };
-            return range(engine);
+            // Built from the raw generator output (Mersenne Twister's genrand_res53)
+            // rather than std::uniform_real_distribution, whose algorithm differs
+            // between libstdc++ versions and libc++; offline replays must agree
+            // across the native harness and the browser build.
+            uint32_t a = engine()() >> 5;
+            uint32_t b = engine()() >> 6;
+            double unit = (a * 67108864.0 + b) * (1.0 / 9007199254740992.0);
+            return static_cast<T>(from + (to - from) * unit);
         }
 
         template <class T>
@@ -70,10 +81,11 @@ namespace jrc
             if (from >= to)
                 return from;
 
-            std::uniform_int_distribution<T> range(from, to - 1);
-            std::random_device rd;
-            std::default_random_engine engine{ rd() };
-            return range(engine);
+            // Modulo mapping of one 32-bit draw. The tiny bias is irrelevant for
+            // game AI; portability of the exact sequence is what matters here.
+            uint64_t span = static_cast<uint64_t>(to) - static_cast<uint64_t>(from);
+            uint32_t draw = engine()();
+            return static_cast<T>(from + static_cast<T>(draw % span));
         }
 
         template <class E>
@@ -88,5 +100,12 @@ namespace jrc
             auto next_underlying = next_int<typename std::underlying_type<E>::type>(from, to);
             return static_cast<E>(next_underlying);
         }
+
+    private:
+        static std::mt19937& engine()
+        {
+            static std::mt19937 shared{ std::random_device{}() };
+            return shared;
+        }
     };
 }
