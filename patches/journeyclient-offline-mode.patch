+        {
+            // No lt/rb on this frame: the trap is not dangerous right now.
+            return {};
+        }
+        if (flip)
+        {
+            box = Rectangle<int16_t>(
+                static_cast<int16_t>(-box.r()), static_cast<int16_t>(-box.l()), box.t(), box.b());
+        }
+        box.shift(get_position());
+        return box;
     }
 
